# Required for prediction-market and RSS database ingestion
TIMESCALE_SERVICE_URL=

# Used only when regex normalization needs the Gemini fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Recent X/Twitter integration is owned separately by Bryson.
# Optional free API registrations
AISSTREAM_API_KEY=
EIA_API_KEY=
FRED_API_KEY=
USDA_NASS_API_KEY=
USDA_FAS_API_KEY=

# Recommended: replace with your email for NOAA API identification
NOAA_USER_AGENT=nostos/1.0 (dplynn@smu.edu)

KALSHI_API_KEY=
KALSHI_SECRET_KEY=
POLYMARKET_BASE_URL=
TYPESAFE_API_KEY= 
ALPACA_API_KEY=
ALPACA_SECRET_KEY= 
ALPACA_BASE_URL= 
FT_RSS_FEED= 
WSJ_BASE_RSS_FEED= 
GROK_BOT_WEBHOOK_URL=
GROK_BOT_WEBHOOK_KEY=
GROK_BOT_AUTH=
NOSTOS_ANSWER_SECRET=

# api/main.py REST routes for the web app (Clerk session tokens)
CLERK_DOMAIN=
WEB_ORIGINS=https://trynostos.biz,http://localhost:8000,http://localhost:5173

# web app (Clerk dashboard > API keys); compose passes it to the web build
VITE_CLERK_PUBLISHABLE_KEY=

# Optional: Clerk OAuth app for the /mcp route (agents sign in through Clerk). Unset = MCP open.
CLERK_OAUTH_CLIENT_ID=
CLERK_OAUTH_CLIENT_SECRET=
PUBLIC_BASE_URL=https://trynostos.biz

# Cloudflare Zero Trust > Networks > Tunnels > create tunnel > copy the token
CLOUDFLARE_TUNNEL_TOKEN=

# OpenSky Network global flight snapshot (flights.py). Blank = anonymous, 15-min refresh.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Voyage routing (voyage/, docs/VULTR.md). Vultr Object Storage holds the trained speed model;
# blank = local volume only. Endpoint is the bucket's region host, e.g. https://ewr1.vultrobjects.com
VULTR_OBJECT_STORAGE_ENDPOINT=
VULTR_OBJECT_STORAGE_BUCKET=
VULTR_OBJECT_STORAGE_ACCESS_KEY=
VULTR_OBJECT_STORAGE_SECRET_KEY=
# Optional Open-Meteo commercial key (free tier: 600 points/min, 10k/day, shared with world_data/tides)
OPEN_METEO_API_KEY=
# CPU threads for training and the bootstrap model (default: all for training, 2 for the API)
VOYAGE_N_JOBS=
